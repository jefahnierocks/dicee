{
  "mcpServers": {
    "akg": {
      "type": "local",
      "command": "bun",
      "args": [
        "run",
        "/absolute/path/to/dicee/packages/web/src/tools/akg/mcp/server.ts"
      ],
      "env": {
        "AKG_GRAPH_PATH": "/absolute/path/to/dicee/docs/architecture/akg/graph/current.json",
        "AKG_DIAGRAMS_PATH": "/absolute/path/to/dicee/docs/architecture/akg/diagrams"
      },
      "description": "Dicee Architecture Knowledge Graph for layer validation and invariants",
      "tools": ["*"]
    }
  }
}
