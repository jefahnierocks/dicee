# Dicee Project - direnv configuration
# Auto-loads mise tool versions and project environment

# Load mise-managed tool versions (Node 24, Rust)
use mise

# Default to dev environment for local work and normalize unsupported values
case "${DICEE_ENV:-dev}" in
  dev|staging|prod)
    export DICEE_ENV="${DICEE_ENV:-dev}"
    ;;
  *)
    export DICEE_ENV="dev"
    ;;
esac

# Optional repo-local non-secret overrides (gitignored)
source_env_if_exists .envrc.local.nonsecret

# Local bootstrap/operator secrets are resolved at process launch time from
# 1Password via the scripts in ./scripts. No secrets are exported from direnv.
