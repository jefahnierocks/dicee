{
	"name": "@dicee/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mobile": "./scripts/mobile-test.sh",
		"dev:network": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"preview:mobile": "vite preview --host",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:agent": "vitest run --reporter=agent",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:full": "CI=1 playwright test",
		"test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
		"biome:check": "biome check . --reporter=concise",
		"biome:fix": "biome check --write .",
		"format": "biome format --write .",
		"types": "node scripts/wrangler-types.mjs",
		"types:check": "node scripts/wrangler-types.mjs --check",
		"qr": "node scripts/qr.mjs",
		"dev:worker": "wrangler dev",
		"deploy": "wrangler deploy",
		"analyze-logs": "tsx src/tools/log-analyzer/cli.ts",
		"cdp:list": "node scripts/cdp-console-monitor.mjs --list",
		"cdp:local": "node scripts/cdp-console-monitor.mjs --local",
		"cdp:prod": "node scripts/cdp-console-monitor.mjs --production",
		"cdp:monitor": "node scripts/cdp-console-monitor.mjs"
	},
	"dependencies": {
		"@dicebear/collection": "catalog:",
		"@dicebear/core": "catalog:",
		"@dicee/shared": "workspace:*",
		"@supabase/ssr": "catalog:",
		"@supabase/supabase-js": "catalog:",
		"reconnecting-websocket": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/svelte": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"jsdom": "catalog:",
		"miniflare": "catalog:",
		"qrcode-terminal": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"ts-morph": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-wasm": "catalog:",
		"vitest": "catalog:",
		"vitest-axe": "catalog:",
		"wrangler": "catalog:",
		"ws": "catalog:"
	},
	"engines": {
		"node": ">=24.18.0 <25"
	}
}
