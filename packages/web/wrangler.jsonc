{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dicee",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["nodejs_compat"],
	"services": [{ "binding": "GAME_WORKER", "service": "dicee" }],
	// Note: `observability` is a Workers-only field and is not supported in a Pages
	// wrangler config (see the DO Worker's wrangler.jsonc). Pages observability is
	// configured in the Cloudflare dashboard, not here.
	"vars": { "ENVIRONMENT": "production" },
	"env": {
		"preview": {
			"services": [{ "binding": "GAME_WORKER", "service": "dicee" }],
			"vars": { "ENVIRONMENT": "preview" }
		}
	}
}

// PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY, and secret values belong in
// the Cloudflare environment or encrypted deployment flow, never in this file.
