{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The web Worker: SvelteKit SSR plus Workers Static Assets. Game state stays in the
	// separate `dicee` Worker so UI-only releases never restart its Durable Objects.
	"name": "dicee-web",
	// Both paths are written by @sveltejs/adapter-cloudflare during `vite build`.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["nodejs_compat"],
	// No workers.dev subdomain and no per-version Preview URLs: there is no hosted
	// preview, and `dicee.games` is attached as a custom domain by the operator.
	"workers_dev": false,
	"preview_urls": false,
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
	"services": [{ "binding": "GAME_WORKER", "service": "dicee" }],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	}
}

// PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are build-time inputs; secret values
// belong in the Cloudflare environment or encrypted deployment flow, never in this file.
