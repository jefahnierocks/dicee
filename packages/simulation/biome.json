{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**/*.ts", "*.ts", "*.json", "!dist", "!results", "!test-output"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": { "organizeImports": "on" }
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noFocusedTests": "error",
				"noSkippedTests": "warn"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["**/__tests__/**/*.ts", "**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": { "noExplicitAny": "warn" },
					"complexity": { "noExcessiveCognitiveComplexity": "off" }
				}
			}
		}
	]
}
