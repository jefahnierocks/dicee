{
	"name": "@dicee/cloudflare-do",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./ai": {
			"types": "./src/ai/index.ts",
			"import": "./src/ai/index.ts"
		}
	},
	"scripts": {
		"dev": "wrangler dev --env development",
		"deploy": "wrangler deploy --env=",
		"deploy:staging": "wrangler deploy --env staging",
		"tail": "wrangler tail --env=",
		"types": "wrangler types --env-file=/dev/null",
		"types:check": "wrangler types --env-file=/dev/null --check",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . --reporter=concise",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:agent": "vitest run --reporter=agent",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:all": "vitest run && vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@dicee/shared": "workspace:*",
		"jose": "catalog:",
		"nanoid": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@dicee/web": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=24.18.0 <25"
	}
}
